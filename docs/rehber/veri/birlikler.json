    "satirlar": [
      {
        "ad": "Zırhlı Dalgıç",
        "esin": "İçini 1 atmosferde tutan sert basınç kıyafetleri: dalgıç, derinliğin ezici basıncını eklemli bir kabuğun içinde hissetmez.",
        "ozellik": "Faraday kabuğu: iletken dış kabuk ark akımını gövdeden geçirip suya verir; Ark Askerine karşı üstün."
      },
      {
        "ad": "Zıpkıncı",
        "esin": "Lastikli ve pnömatik zıpkın tüfekleri, gaz kartuşlu fırlatıcılar, patlayıcı uçlar; geç kademede bobin ve ray hızlandırıcılar.",
        "ozellik": "Delici atış: hasarının %85'ini ön safa verir; ağır kabukları deler, Zırhlı Dalgıça karşı üstün. En hızlı tür."
      },
      {
        "ad": "Ark Askeri",
        "esin": "Yalıtımlı temas mızrakları, şok çubukları, ıslak kaynak ve kesme arkları; tuzlu suda akım dağılır, bu yüzden silah hedefe dokunarak ya da çok kısa mesafede ateşlenir.",
        "ozellik": "Zincir ark: hasarı ön ve arka safa yarı yarıya yayılır; hafif korunan zıpkıncıları sersemletir, Zıpkıncıya karşı üstün."
      },
      {
        "ad": "Delici",
        "esin": "Hidrolik kesiciler, elmas tel testereler, aşındırıcılı su jeti, termik mızrak ve tünel açma burguları: batık kurtarma ve deniz tabanı sondajının araçları.",
        "ozellik": "Askerlere karşı hasarı ×0,6; yapılara (Kalkan, kale, yuva) karşı ×3. Taşıma kapasitesi diğer türlerin iki katından fazla. Üçgenin dışındadır."
      }
    ]
  },
