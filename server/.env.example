# Copy to .env on the server and fill in. Never commit .env.
HADAL_DB_PASSWORD=change-me
# HS256 key for access tokens, at least 32 chars: head -c 48 /dev/urandom | base64 | tr -d '/+='
HADAL_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Patch check served at /manifest/version.json
HADAL_MIN_CLIENT_VERSION=0.0.0
HADAL_LATEST_CLIENT_VERSION=0.0.0
HADAL_MAINTENANCE=false
HADAL_MAINTENANCE_MESSAGE=
